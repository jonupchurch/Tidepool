# Spec-Kit runtime pointer (regenerated per session; not shared).
# NOTE: specs/ IS committed in this repo — it's the project's spec artifacts,
# not disposable engine state (unlike the ai-tools toolkit repo it came from).
.specify/feature.json

# Machine-local Claude Code settings (permissions/paths, personal overrides).
.claude/settings.local.json

# Dependencies
/node_modules
.pnp
.pnp.*

# Build output (Vite)
/dist
/dist-ssr
*.local

# Tauri (Rust build artifacts + generated bindings)
/src-tauri/target/
/src-tauri/gen/

# Steam (SteamPipe). The VDF scripts ARE committed — they're the build config.
# Staged content, upload logs/chunk caches, the steamcmd install and the
# per-run generated build script are all derived or huge.
/steam/content/
/steam/output/
/steam/builder/
/steam/scripts/.app_build.run.vdf

# Audio/art masters. Archival sources we re-encode the shipped assets FROM —
# not shipped themselves, and big (a WAV master is ~8x its MP3). Kept out of
# src/ so Vite's build-time asset globs can't sweep them into the bundle, and
# out of git so a clone doesn't carry tens of MB of files nobody plays.
# Keep your own copies; src/assets/music/README.md records what each one is.
/assets/masters/

# Testing (Vitest coverage, Playwright artifacts)
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# TypeScript
*.tsbuildinfo

# Logs / debug
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env files (never commit secrets)
.env
.env.*
!.env.example

# Editor / OS cruft
.DS_Store
Thumbs.db
.idea/
*.pem
